# SAMPLE configuration file
# Move this file to 'scripts.conf' in the same directory
# as the connect/custom/trigger scripts

# Sonarr info used to talk to its api
SONARR_API_URL="http://ip.of.sonarr:8989/api/v3"
SONARR_API_KEY="your_sonarr_api_key"

# TMDB API key for recap lookups
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY="your_tmdb_api_key"

# Recap languages to search (comma-separated, ISO 639-1 with optional region)
# "original" is a special value that resolves to the series' original language at runtime
RECAP_LANGUAGES="original,pt-BR"

# Subtitle languages to download for original-language recaps (comma-separated)
# Uses yt-dlp's --sub-langs. Empty value disables subtitles.
RECAP_SUBTITLE_LANGS="pt-BR"

# Fan-made recap handling: never | fallback | always
#   never    - only official recaps (TMDB + YouTube)
#   fallback - official first, fan-made only when no official recap exists (default)
#   always   - always also download fan-made recaps alongside official ones
FAN_MADE="fallback"

# Where to store recaps following the Plex extras naming scheme:
#   show   - ShowName (Year)/Other/Recap-S01-official-en.mp4
#   season - ShowName (Year)/Season 01/Other/Recap-S01-official-en.mp4
#   both   - show level, hardlinked (or copied) into the season folder
STORAGE_MODE="show"

# Path to a Netscape-format cookie file for yt-dlp YouTube authentication.
# Optional - leave empty to download without authentication.
# See docs/cookie-extraction.md for instructions on exporting cookies from your browser.
YT_DLP_COOKIE_FILE=""

# Autopulse notification (optional). Uncomment and set URL to enable Plex scan after recap download.
# AUTOPULSE_URL="http://ip:3030"
# AUTOPULSE_TRIGGER="manual"
# AUTOPULSE_AUTH_USER="username"
# AUTOPULSE_AUTH_PASS="password"

# yt-dlp format selector. Default gets best quality then recodes to MP4 for compatibility.
# YT_DLP_FORMAT="bv*+ba/b"

# Target container for --recode-video. MP4 ensures H.264+AAC, Direct Play on all devices.
# YT_DLP_RECODE="mp4"

# Dry-run mode. When true, skips actual yt-dlp download, shows what would happen.
DRY_RUN="false"

# Debug mode. When true, prints detailed diagnostic messages.
DEBUG="false"
