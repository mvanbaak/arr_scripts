# SAMPLE configuration file - Sonarr settings.
# Move this file to 'scripts.conf' in the same directory (sonarr/).
# These values override the shared settings from common/scripts.conf.

# Sonarr info used to talk to its api
SONARR_API_URL="http://ip.of.sonarr:8989/api/v3"
SONARR_API_KEY="your_sonarr_api_key"

# Recap languages to search (comma-separated, ISO 639-1 with optional region)
# "original" is a special value that resolves to the series' original language at runtime
RECAP_LANGUAGES="original,pt-BR"

# Subtitle languages to download for original-language recaps (comma-separated)
# Uses yt-dlp's --sub-langs. Empty value disables subtitles.
RECAP_SUBTITLE_LANGS="pt-BR"

# Fan-made recap handling: never | fallback | always
#   never    - only official recaps (TMDB + YouTube)
#   fallback - official first, fan-made only when no official recap exists (default)
#   always   - always also search fan-made; official recaps still rank higher
FAN_MADE="fallback"

# Where to store recaps following the Plex extras naming scheme.
# A recap of season N lands in the Season N+1 folder (the season being watched).
# Filenames use the video title with source and language tags for Plex, e.g.
# S05 - Season 5 Recap (official-en).mp4
#   show   - ShowName (Year)/Other/S01 - First Season Recap (official-en).mp4
#   season - ShowName (Year)/Season 02/Other/S01 - First Season Recap (official-en).mp4
#   both   - show level, hardlinked (or copied) into the season folder
STORAGE_MODE="show"

# How many YouTube results to consider per recap search (default 10)
RECAP_SEARCH_COUNT="10"
